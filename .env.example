# --- NEURA RUM (Real User Monitoring) ---
# Sin VITE_RUM_ENDPOINT / VITE_RUM_KEY el SDK no se inicializa (no-op).
VITE_RUM_ENDPOINT=https://a.rum.neura.pe/functions/v1/rum-ingest
# key publica del proyecto en rum_projects (identifica, no autentica)
VITE_RUM_KEY=46bdad4b6d4b053f6539f6f7
# main | develop | perception (si falta se infiere por hostname)
VITE_RUM_ENV=develop
# VITE_RUM_DEBUG=true   # loguea cada evento en la consola del navegador

# Token de lectura de GitHub Packages para instalar @opolarity/rum (solo build / instalacion local).
# En Coolify va como Build Variable; en local exportarlo en el shell antes de npm install.
# NPM_TOKEN=ghp_xxx
